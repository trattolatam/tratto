generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  BUSINESS
  ADMIN
}

enum CompanyPlan {
  FREE
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REPORTED
}

enum AdStatus {
  PENDING
  ACTIVE
  PAUSED
  REJECTED
  EXHAUSTED
}

enum AdModel {
  CPC
  CPM
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

enum PaymentProvider {
  STRIPE
  DLOCALGO
  PAYPAL
}

enum MedalType {
  TOP_CATEGORY
  FIFTY_REVIEWS
  CONSISTENT_12M
  TRENDING_UP
  HIGHLY_RECOMMENDED
  CHOICE_OF_YEAR
}

enum NotificationType {
  NEW_REVIEW
  REVIEW_RESPONSE
  MEDAL_EARNED
  MEDAL_ALMOST
  MONTHLY_REPORT
  SUBSCRIPTION_RENEWAL
  AD_APPROVED
  AD_REJECTED
  LEAD_RECEIVED
  TEAM_INVITE
  AD_LOW_BALANCE
}

// ─── USUARIOS ─────────────────────────────────────────────────────────────────

enum AgeRange {
  R18_24
  R25_34
  R35_44
  R45_54
  R55_64
  R65_PLUS
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum IncomeLevel {
  LOW
  MEDIUM
  HIGH
  PREFER_NOT_TO_SAY
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          UserRole  @default(USER)
  country       String
  city          String?
  phone         String?
  avatarUrl     String?
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?

  // Verificación de email
  emailVerificationToken      String?
  emailVerificationExpiresAt  DateTime?

  // Recuperación de contraseña
  passwordResetToken      String?
  passwordResetExpiresAt  DateTime?

  // Datos de segmentación para publicidad — opcionales, se piden después del
  // registro (no en el formulario en sí, para no perder gente por fricción).
  // targetingAskedAt queda seteado apenas pasó por esa pantalla, haya
  // completado algo o salteado todo — así no se la volvemos a mostrar.
  ageRange      AgeRange?
  gender        Gender?
  interests     String[]     @default([])
  incomeLevel   IncomeLevel?
  targetingAskedAt DateTime?
  targetingSkipCount Int     @default(0)

  // Tier 2 — Pro user
  isPro         Boolean   @default(false)
  proSince      DateTime?
  referralCode  String?   @unique
  referredById  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviews        Review[]
  reviewHelpful  ReviewHelpful[]
  company        Company?         @relation("CompanyOwner")
  notifications  Notification[]
  contactReveals ContactReveal[]
  claimDisputes  ClaimDispute[]   @relation("DisputesFiled")
  companyMemberships CompanyMember[]
  referredBy     User?            @relation("Referrals", fields: [referredById], references: [id])
  referrals      User[]           @relation("Referrals")
  adAccounts     AdAccount[]

  @@map("users")
}

// ─── CATEGORÍAS ───────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  emoji       String
  phase       Int       @default(1)
  priority    Boolean   @default(false)
  isHidden    Boolean   @default(false)
  parentId    String?

  createdAt   DateTime  @default(now())

  companies   Company[]
  adTargets   AdTargetCategory[]
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")

  @@map("categories")
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model CategorySuggestion {
  id            String            @id @default(uuid())
  companyId     String            @unique
  suggestedName String
  status        SuggestionStatus  @default(PENDING)
  createdAt     DateTime          @default(now())
  reviewedAt    DateTime?

  company       Company           @relation(fields: [companyId], references: [id])

  @@map("category_suggestions")
}

// ─── EMPRESAS ─────────────────────────────────────────────────────────────────

model Company {
  id            String      @id @default(uuid())
  name          String
  slug          String      @unique
  description   String?
  categoryId    String
  country       String
  city          String
  address       String?
  phone         String?
  website       String?
  email         String?

  taxId         String?
  taxIdType     String?
  taxIdChecksumValid Boolean?
  personalIdNumber   String?
  verificationDocUrl String?
  verificationDocType String?

  claimedById   String?     @unique
  claimedAt     DateTime?

  plan          CompanyPlan @default(FREE)
  isVerified    Boolean     @default(false)
  verifiedAt    DateTime?

  ratingAvg     Float       @default(0)
  reviewCount   Int         @default(0)
  verifiedReviewCount Int   @default(0)

  logoUrl       String?
  coverUrl      String?
  photos        String[]    @default([])

  bookingEnabled  Boolean   @default(false)
  insuranceActive Boolean   @default(false)

  metaTitle       String?
  metaDescription String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  category      Category    @relation(fields: [categoryId], references: [id])
  categorySuggestion CategorySuggestion?
  owner         User?       @relation("CompanyOwner", fields: [claimedById], references: [id])
  reviews       Review[]
  medals        Medal[]
  subscription  Subscription?
  boosts        ProfileBoost[]
  leads         Lead[]
  contactReveals ContactReveal[]
  disputes      ClaimDispute[]   @relation("CompanyDisputes")
  aiSummary     AiSummary?
  apiKeys       ApiKey[]
  members       CompanyMember[]
  teamInvites   TeamInvite[]
  branches      Branch[]
  webhooks      Webhook[]

  @@index([country, city, categoryId])
  @@index([ratingAvg])
  @@map("companies")
}

// ─── RESEÑAS ──────────────────────────────────────────────────────────────────

model Review {
  id            String        @id @default(uuid())
  companyId     String
  userId        String
  branchId      String?
  rating        Int
  title         String?
  body          String
  proofUrl      String?
  proofType     String?
  photos        String[]      @default([])
  isVerified    Boolean       @default(false)
  verifiedAt    DateTime?
  status        ReviewStatus  @default(PENDING)
  moderatedById String?
  moderatedAt   DateTime?
  moderationNote String?

  helpfulCount  Int           @default(0)
  aiSummaryId   String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  branch        Branch?       @relation(fields: [branchId], references: [id])
  response      ReviewResponse?
  helpful       ReviewHelpful[]

  @@index([companyId, status])
  @@index([userId])
  @@map("reviews")
}

model ReviewResponse {
  id          String    @id @default(uuid())
  reviewId    String    @unique
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  review      Review    @relation(fields: [reviewId], references: [id])

  @@map("review_responses")
}

model ReviewHelpful {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id])
  review    Review  @relation(fields: [reviewId], references: [id])

  @@id([userId, reviewId])
  @@map("review_helpful")
}

// ─── MEDALLAS ─────────────────────────────────────────────────────────────────

model Medal {
  id          String      @id @default(uuid())
  companyId   String
  type        MedalType
  awardedAt   DateTime    @default(now())
  expiresAt   DateTime?
  visible     Boolean     @default(true)
  year        Int

  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([companyId, type, year])
  @@map("medals")
}

// ─── SUSCRIPCIONES ────────────────────────────────────────────────────────────

model Subscription {
  id                String              @id @default(uuid())
  companyId         String              @unique
  plan              CompanyPlan
  provider          PaymentProvider
  providerSubId     String              @unique
  status            SubscriptionStatus  @default(ACTIVE)
  amountUsd         Float
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean             @default(false)
  trialEndsAt       DateTime?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company           Company             @relation(fields: [companyId], references: [id])
  payments          Payment[]

  @@map("subscriptions")
}

model Payment {
  id              String          @id @default(uuid())
  subscriptionId  String?
  adAccountId     String?
  provider        PaymentProvider
  providerPayId   String          @unique
  amountUsd       Float
  status          String
  description     String?
  createdAt       DateTime        @default(now())

  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
  adAccount       AdAccount?      @relation(fields: [adAccountId], references: [id])

  @@map("payments")
}

// ─── PUBLICIDAD ───────────────────────────────────────────────────────────────

model AdAccount {
  id          String    @id @default(uuid())
  userId      String
  companyName String
  balance     Float     @default(0)
  lowBalanceNotifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  ads         Ad[]
  payments    Payment[]

  @@map("ad_accounts")
}

model Ad {
  id            String    @id @default(uuid())
  adAccountId   String
  title         String
  description   String
  imageUrls     String[]
  price         Float?
  ctaText       String    @default("Consultar precio")
  ctaUrl        String?

  // Datos de contacto — obligatorios al CREAR un anuncio (lo valida el
  // formulario y el backend), pero opcionales acá a nivel de base para no
  // romper anuncios viejos que se hayan cargado antes de este cambio.
  // WhatsApp y teléfono se guardan ya normalizados en formato E.164
  // (ej: +59897550450), validados contra el país con libphonenumber-js.
  whatsappCountry String?
  whatsappNumber  String?
  phoneCountry    String?
  phoneNumber     String?
  contactEmail    String?
  websiteUrl      String?
  instagramUrl    String?
  facebookUrl     String?

  model         AdModel   @default(CPC)
  cpcUsd        Float     @default(0.35)
  cpmUsd        Float?
  dailyBudget   Float
  totalSpent    Float     @default(0)
  status        AdStatus  @default(PENDING)
  targetCountries String[] @default([])
  rejectionNote String?
  approvedAt    DateTime?
  approvedById  String?

  impressions   Int       @default(0)
  clicks        Int       @default(0)
  conversions   Int       @default(0)

  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Segmentación demográfica — array vacío en cualquiera de estos = sin filtro
  // en esa dimensión (le llega a todos). Se cruza contra el perfil que el
  // usuario cargó (opcional) en /completar-perfil.
  targetAgeRanges    AgeRange[]    @default([])
  targetGenders      Gender[]      @default([])
  targetInterests    String[]      @default([])
  targetIncomeLevels IncomeLevel[] @default([])

  adAccount     AdAccount         @relation(fields: [adAccountId], references: [id])
  targetCategories AdTargetCategory[]
  adEvents      AdEvent[]

  @@map("ads")
}

model AdTargetCategory {
  adId        String
  categoryId  String

  ad          Ad        @relation(fields: [adId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@id([adId, categoryId])
  @@map("ad_target_categories")
}

model AdEvent {
  id        String    @id @default(uuid())
  adId      String
  type      String
  userId    String?
  country   String?
  city      String?
  costUsd   Float?    // solo en eventos que realmente cobraron algo — permite
                       // calcular gasto real por período, no solo el total acumulado
  createdAt DateTime  @default(now())

  ad        Ad        @relation(fields: [adId], references: [id])

  @@index([adId, type])
  @@index([adId, userId, createdAt])
  @@map("ad_events")
}

// ─── LEADS ────────────────────────────────────────────────────────────────────

model Lead {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  email       String?
  phone       String?
  message     String?
  source      String    @default("profile")
  chargedAt   DateTime?
  amountUsd   Float?    @default(5)
  respondedAt DateTime?

  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id])

  @@map("leads")
}

// ─── REVELADO DE CONTACTO (teléfono/web ocultos hasta hacer click) ────────────

model ContactReveal {
  id          String    @id @default(uuid())
  companyId   String
  userId      String?
  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@map("contact_reveals")
}

// ─── DENUNCIA DE RECLAMO FALSO ──────────────────────────────────────────────

model ClaimDispute {
  id              String    @id @default(uuid())
  companyId       String
  disputedById    String
  reason          String
  evidenceDocUrl  String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime  @default(now())

  company         Company   @relation("CompanyDisputes", fields: [companyId], references: [id])
  disputedBy      User      @relation("DisputesFiled", fields: [disputedById], references: [id])

  @@index([companyId, status])
  @@map("claim_disputes")
}

// ─── BOOST DE PERFIL ──────────────────────────────────────────────────────────

model ProfileBoost {
  id          String    @id @default(uuid())
  companyId   String
  amountUsd   Float
  daysCount   Int
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id])

  @@map("profile_boosts")
}

// ─── NOTIFICACIONES ───────────────────────────────────────────────────────────

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean           @default(false)
  sentEmail Boolean           @default(false)
  sentWhatsapp Boolean        @default(false)
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── IA RESÚMENES (Tier 2) ────────────────────────────────────────────────────

model AiSummary {
  id            String    @id @default(uuid())
  companyId     String    @unique
  summaryText   String
  insightBars   Json
  reviewsCount  Int
  generatedAt   DateTime  @default(now())

  company       Company   @relation(fields: [companyId], references: [id])

  @@map("ai_summaries")
}

// ─── API KEYS — integración de calificaciones (plan Premium) ─────────────────

model ApiKey {
  id           String    @id @default(uuid())
  name         String
  keyHash      String    @unique
  companyId    String
  planTier     String    @default("basic")
  monthlyLimit Int       @default(1000)
  usageCount   Int       @default(0)
  usageResetAt DateTime  @default(now())
  lastUsedAt   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  company      Company   @relation(fields: [companyId], references: [id])

  @@map("api_keys")
}

// ─── EQUIPO — múltiples usuarios por empresa (plan Enterprise) ────────────────
// El dueño original de la empresa sigue siendo Company.owner (sin cambios);
// esto es solo para las personas ADICIONALES que el dueño invita a su equipo.

enum CompanyMemberRole {
  ADMIN
  EDITOR
  VIEWER
}

model CompanyMember {
  id         String            @id @default(uuid())
  companyId  String
  userId     String
  role       CompanyMemberRole @default(EDITOR)
  invitedAt  DateTime          @default(now())

  company    Company           @relation(fields: [companyId], references: [id])
  user       User              @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@map("company_members")
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
}

// Invitación a alguien que TODAVÍA no tiene cuenta en Tratto — cuando se registra
// con este email, queda asociado automáticamente a la empresa con este rol.
model TeamInvite {
  id          String            @id @default(uuid())
  companyId   String
  email       String
  role        CompanyMemberRole @default(EDITOR)
  status      TeamInviteStatus  @default(PENDING)
  invitedById String
  createdAt   DateTime          @default(now())
  acceptedAt  DateTime?

  company     Company           @relation(fields: [companyId], references: [id])

  @@unique([companyId, email])
  @@map("team_invites")
}

// ─── SUCURSALES — múltiples sedes bajo un mismo perfil (plan Enterprise) ──────

model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  address   String
  city      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])
  reviews   Review[]

  @@map("branches")
}

// ─── WEBHOOKS — notificaciones en tiempo real a sistemas externos (Enterprise) ─

model Webhook {
  id        String   @id @default(uuid())
  companyId String
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])

  @@map("webhooks")
}

// ─── FOTO MENSUAL — para mostrar evolución en el tiempo, no solo la foto de hoy ─

model CompanyRatingSnapshot {
  id          String   @id @default(uuid())
  companyId   String
  ratingAvg   Float
  reviewCount Int
  rankPosition Int?
  rankTotal   Int?
  capturedAt  DateTime @default(now())

  @@index([companyId, capturedAt])
  @@map("company_rating_snapshots")
}
